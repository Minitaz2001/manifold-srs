{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://manifold-srs.local/schemas/figure.schema.json",
  "title": "Figure",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "module", "dimension_id", "svg_path", "regions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "module": {
      "type": "string",
      "enum": ["geography", "physics", "natural_world", "are_built"]
    },
    "dimension_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "svg_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_./-]+\\.svg$"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "source_note": {
      "type": "string",
      "minLength": 4,
      "maxLength": 400
    },
    "regions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "label"],
        "properties": {
          "region_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "entity_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "adjacent_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
