{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://manifold-srs.local/schemas/pack.schema.json",
  "title": "ContentPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "version",
    "release_date",
    "module",
    "entities",
    "dimensions",
    "facts",
    "anchor_sets",
    "figures",
    "plain_cards"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "release_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "module": {
      "type": "string",
      "enum": ["geography", "physics", "natural_world", "are_built"]
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "entity.schema.json" }
    },
    "dimensions": {
      "type": "array",
      "items": { "$ref": "dimension.schema.json" }
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "fact.schema.json" }
    },
    "anchor_sets": {
      "type": "array",
      "items": { "$ref": "anchor_set.schema.json" }
    },
    "figures": {
      "type": "array",
      "items": { "$ref": "figure.schema.json" }
    },
    "plain_cards": {
      "type": "array",
      "items": { "$ref": "plain_card.schema.json" }
    },
    "ordering_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "ordered_entity_ids"],
        "properties": {
          "dimension_id": { "type": "string" },
          "ordered_entity_ids": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
