 {
  "key": "physics|card|phy-rule-drag",
  "front": "Aerodynamic drag force and required power scale with speed v how?",
  "back": "Drag force F ∝ v²; required power P = F·v ∝ v³ (doubling speed multiplies drag 4× and power 8×).",
  "source_url": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(speed)"
 },
 {
  "key": "physics|card|phy-rule-square-cube",
  "front": "Square-cube law: if you double a structure's linear dimensions, what happens to surface area and mass?",
  "back": "Surface area scales 4× (L²); volume and mass scale 8× (L³) — why elephants have pillar legs and small animals lose heat fast.",
  "source_url": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(length)"
 },
 {
  "key": "physics|card|phy-rule-stefan-boltzmann",
  "front": "Radiative heat emission (Stefan–Boltzmann) scales with absolute temperature T how?",
  "back": "P ∝ T⁴ (in Kelvin). Doubling absolute temperature increases thermal radiation 16×.",
  "source_url": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(temperature)"
 },
 {
  "key": "physics|card|phy-rule-diffusion",
  "front": "Characteristic diffusion time t across distance L scales how?",
  "back": "t ≈ L² / D (scales with the SQUARE of distance — fast across a 1 µm cell, hopelessly slow across 1 cm).",
  "source_url": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(length)"
 },
 {
  "key": "physics|card|phy-rule-db",
  "front": "Decibels (dB): what power/intensity multiplier corresponds to +3 dB and +10 dB?",
  "back": "+3 dB ≈ 2× power; +10 dB = 10× power (+20 dB = 100×; perceived loudness doubles roughly every +10 dB).",
  "source_url": "https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors"
 },
 {
  "key": "physics|card|phy-rule-carnot",
  "front": "Carnot maximum heat-engine efficiency formula (temperatures in Kelvin)?",
  "back": "η_max = 1 − T_cold / T_hot. At 300 K ambient and 600 K steam, absolute ceiling is 50%.",
  "source_url": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(temperature)"
 },
 {
  "key": "physics|card|phy-rule-kwh-mj",
  "front": "1 kilowatt-hour (kWh) equals how many megajoules (MJ) and kilocalories?",
  "back": "1 kWh = 3.6 MJ ≈ 860 kcal (a human's ~2,000 kcal daily food intake is only ~2.3 kWh!).",
  "source_url": "https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors"
 },
 {
  "key": "physics|card|phy-rule-water-heat",
  "front": "Water specific heat capacity and latent heat of vaporization?",
  "back": "Specific heat = 4.18 kJ/(kg·K); latent heat of vaporization = 2,260 kJ/kg (~5.4× the energy to heat water from 0→100 °C).",
  "source_url": "https://en.wikipedia.org/wiki/Energy_density"
 },
 {
  "key": "physics|card|phy-rule-solar-flux",
  "front": "Solar irradiance at top of atmosphere vs. peak clear noon vs. 24-hour global surface mean?",
  "back": "Top of atmosphere = 1,361 W/m²; peak sea-level noon ≈ 1,000 W/m²; 24-hour global average ≈ 180–200 W/m².",
  "source_url": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(power)"
 },
 {
  "key": "physics|card|phy-rule-wind-power",
  "front": "Wind turbine available power scales with rotor diameter D and wind speed v how?",
  "back": "P = ½ ρ A v³ ∝ D² v³ — a 26% higher wind speed roughly DOUBLES available power.",
  "source_url": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(power)"
 },
 {
  "key": "physics|card|phy-rule-thunder-delay",
  "front": "Speed-of-sound distance rule for lightning/thunder?",
  "back": "Sound travels ~343 m/s → ~3 seconds per kilometer, ~5 seconds per mile.",
  "source_url": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(speed)"
 },
 {
  "key": "physics|card|phy-rule-hydrostatic",
  "front": "Hydrostatic water pressure increases by ~1 atmosphere every how many meters of depth?",
  "back": "~10 meters (33 ft) of water adds ~1 atm (100 kPa / 14.7 psi). At 100 m depth, total pressure is ~11 atm.",
  "source_url": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(pressure)"
 },
 {
  "key": "physics|card|phy-rule-rule-of-72",
  "front": "Rule of 72 (and Rule of 115): doubling and tripling time at r% compounding?",
  "back": "Doubling time ≈ 72 / r (at 7% → ~10.3 yr). Tripling time ≈ 115 / r. (Exact: ln 2 ≈ 0.693).",
  "source_url": "https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors"
 },
 {
  "key": "physics|card|phy-rule-pi-e7",
  "front": "How many seconds are in one year (Fermi anchor)?",
  "back": "≈ π × 10^7 seconds (exact: 3.1557 × 10^7 s, within 0.45% of π × 10^7).",
  "source_url": "https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors"
 },
 {
  "key": "physics|card|phy-rule-margin-error",
  "front": "Quick 95% confidence margin of error for a random poll of size N?",
  "back": "≈ 1 / √N (N = 100 → ±10%, N = 400 → ±5%, N = 1,000 → ±3.1%, N = 10,000 → ±1%).",
  "source_url": "https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors"
 },
 {
  "key": "physics|card|phy-rule-acre-ha",
  "front": "1 acre in square feet and hectares?",
  "back": "1 acre = 43,560 sq ft (≈ 209 ft × 209 ft, roughly a football field without end zones) ≈ 0.405 hectares (1 ha = 10,000 m²).",
  "source_url": "https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors"
 },
 {
  "key": "physics|card|phy-rule-ms-mph",
  "front": "Converting meters per second (m/s) to mph and km/h?",
  "back": "1 m/s = 3.6 km/h ≈ 2.24 mph (10 m/s ≈ 22 mph; 30 m/s ≈ 67 mph).",
  "source_url": "https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors"
 },
 {
  "key": "physics|card|phy-rule-btu-kw",
  "front": "HVAC cooling '1 Ton of Refrigeration' equals how many BTU/hr and kW thermal?",
  "back": "1 ton = 12,000 BTU/hr ≈ 3.52 kW thermal (rate needed to melt 1 short ton of ice over 24 hours).",
  "source_url": "https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors"
 },
 {
  "key": "physics|card|phy-rule-kelvin-ambient",
  "front": "Room temperature (~20 °C / 68 °F) in Kelvin, and thermal energy k_B T in eV?",
  "back": "~293 K (~300 K Fermi anchor); k_B T ≈ 0.026 eV (1/40 eV).",
  "source_url": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(temperature)"
 },
 {
  "key": "physics|card|phy-rule-ideal-gas",
  "front": "Volume of 1 mole of any ideal gas at STP (0 °C, 1 atm)?",
  "back": "22.4 liters (at room temp 25 °C: ~24.5 L). Air mean molar mass ≈ 29 g/mol → 29 g / 24 L ≈ 1.2 kg/m³.",
  "source_url": "https://www.grc.nasa.gov/www/k-12/airplane/atmosmet.html"
 },
